# Copy to .env and fill in. NEVER commit .env.

# Your Immich server base URL (no trailing /api)
IMMICH_URL=http://immich.local:2283
# Immich API key: Account Settings -> API Keys
IMMICH_API_KEY=your-immich-api-key
# Anthropic API key: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# --- Optional overrides (defaults shown) ---

# Storage
# DB_PATH=winnow.db
# CACHE_DIR=.winnow-cache

# Models per stage
# TRIAGE_MODEL=claude-haiku-4-5
# RANK_MODEL=claude-sonnet-5
# FINALS_MODEL=claude-opus-5

# Thumbnail preparation (long edge in px, JPEG quality)
# IMAGE_EDGE=768
# JPEG_QUALITY=82

# Burst detection: seconds between frames, max frames judged as one group,
# and how different two consecutive frames may look before the run is split
# (hamming distance between perceptual hashes, 0-64).
# BURST_GAP_SECONDS=10
# BURST_MAX_GROUP=10
# DHASH_MAX_DISTANCE=26

# Stage 2 — best-worst scaling: photos per set, and how many sets each
# photo appears in.
# BWS_SET_SIZE=8
# BWS_APPEARANCES=4

# Stage 3 — finals: how many top-scoring photos play, over how many rounds.
# FINALS_ROUNDS=3
# FINALS_POOL_SIZE=50

# Thresholds
# The technical_score floor for entering stage 2. Any photo triaged as a
# `candidate` gets in regardless; this is what lets solid-but-unflagged
# photos through. Lower it to rank more photos (and spend more).
# CANDIDATE_SCORE_MIN=8

# Write-back behavior
# Album that collects your best photos (created if missing; "" disables).
# BEST_ALBUM=Five-Stars
# Minimum star band that lands in the album (5 = five-star only, 4 = both).
# BEST_ALBUM_MIN_STARS=5
# Also mark five-star photos as Immich favorites.
# FIVE_STAR_FAVORITE=true

# Max already-scored photos re-judged as ranking anchors per run; every new
# photo is always scored. 0 = unlimited.
# SCORING_LIMIT=0

# Star bands, as fractions of the scored candidate pool. With ~8% of a library
# becoming candidates, the defaults land near the top 0.4% / next 1.2% overall.
# FIVE_STAR_FRACTION=0.05
# FOUR_STAR_FRACTION=0.15
# Full spectrum: also assign 3 stars (remaining ranked candidates), 2 stars
# (ordinary keepers) and 1 star (poor but kept). Rates nearly every photo —
# deliberately opt-in.
# FULL_STAR_SPECTRUM=false
